specification {
  element actor {
    style {
      color green
      shape person
    }
  }
  element system
  element component

  element filesystem {
    style {
      color amber
      icon bootstrap:folder
    }
  }

  element external_system {
    style {
      color gray
    }
  }
  tag warn
}

model {
  customer = actor 'End User' {
    description 'The end user who has bought a Uno Q'
  }

  hardware = external_system "Hardware" {
    description 'Uno Q Hardware Device'
  }
  boot_firmware = system "Boot Firmware" {
    description 'PBL, XBL, U-Boot'

    component pbl "Primary Boot Loader"
    component xbl "Extended Boot Loader"
    component u-boot "U-Boot"

    hardware -> pbl "Loads"
    pbl -> xbl "Loads"
    xbl -> u-boot "Loads"

  }

  uki = system "Unified Kernel Image" {
    description 'Systemd-stub, DeviceTree Files'

    component systemd-stub "Systemd Stub"
    filesystem kernel_components "Kernel Components" "Initframs, Kernel File, Cmdline, DeviceTree"

    u-boot -> systemd-stub "Loads"
    systemd-stub -> uki_addons "Attests and \nloads into configuration"
    systemd-stub -> kernel_components "Loads"

  }

  uki_addons = filesystem "UKI Add-ons"{
    description 'UKI Addons to be merged into UKI'

    filesystem uki_addon_device_tree_overlays "Device Tree Overlay"
    filesystem uki_addon_initframs "Initframs"
    filesystem uki_addon_cmdline "Kernel Commandline"

    systemd-stub -> uki_addon_cmdline "Appends to configuration"
    systemd-stub -> uki_addon_initframs "Replaces loaded initfram"
    systemd-stub -> uki_addon_device_tree_overlays "Merges into DeviceTree "

  }

  operating_system = external_system "Operating System" {
    description 'Linux Debian Operating System'
    style {
      color gray
    }
  }

  configuration = system "Configuration System" {
    description 'Python CLI/TUI tool'

  }

  customer -> hardware "Starts Device Up"
  customer -> configuration "Configures wanted components"
  hardware -> boot_firmware "Initializes"
  boot_firmware -> uki "Loads and verifies signatures"
  uki -> operating_system "Configures environment for"

  configuration -> operating_system "Runs on"
  configuration -> uki "Configures settings of"

}

views {

  view index {
    title 'Landscape view'

    include *
  }

  view bootchain of boot_firmware {
    include *

    style * {
      opacity 25%
    }
    style customer {
      color muted
    }
  }

  view uki of uki {
    include *

    style * {
      opacity 25%
    }
    style customer {
      color muted
    }
  }
  view uki_addons of uki_addons {
    include *

    style * {
      opacity 25%
    }
    style customer {
      color muted
    }
  }
}

