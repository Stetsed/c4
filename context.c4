specification {
  element actor {
    #actor
    style {
      color green
      shape person
    }
  }
  element system
  element component

  tag actor {
    color #FFB072
  }

  tag ui {
    color #33B074
  }
  tag version1 {
    color #D6409F
  }
  tag warn
}

model {
  customer = actor 'End User' {
    description 'The end user who has bought a Uno Q'
  }

  hardware = system "Hardware" {
    description 'Uno Q Hardware Device'
    style {
      color gray
    }
  }
  bootchain = system "Boot Chain" {
    description 'U-Boot, Systemd-stub, UKI'
  }
  operating_system = system "Operating System" {
    description 'Linux Debian Operating System'
    style {
      color gray
    }
  }

  configuration = system "Configuration System" {
    description 'Python CLI/TUI tool'

  }

  customer -> hardware "Starts Device Up"
  customer -> configuration "Configures wanted components"
  hardware -> bootchain "Initializes"
  bootchain -> operating_system "Configures environment for"

  configuration -> operating_system "Runs on"
  configuration -> bootchain "Configures settings of"

}

views {

  view index {
    title 'Landscape view'

    include *
  }

  view saas of saas {
    include *

    style * {
      opacity 25%
    }
    style customer {
      color muted
    }
  }

}

